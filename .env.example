# ---- MongoDB ----
MONGODB_URI=mongodb+srv://USER:PASSWORD@your-cluster.mongodb.net/?appName=Resume-Analyzer
MONGODB_DB=resume_screening

# ---- CogitX (screening / KPI workflow) ----
COGITX_BASE_URL=https://platform.cogitx.ai
COGITX_EXPORT_ID=
COGITX_CLIENT_ID=
COGITX_CLIENT_SECRET=
KPI_TRIGGER_MESSAGE=show kpi dashboard

# ---- CogitX (email workflow) ----
COGITX_EMAIL_EXPORT_ID=
COGITX_EMAIL_CLIENT_ID=
COGITX_EMAIL_CLIENT_SECRET=

# ---- CogitX (email ingestion workflow) ----
COGITX_INGEST_EXPORT_ID=
COGITX_INGEST_CLIENT_ID=
COGITX_INGEST_CLIENT_SECRET=

# ---- CORS: comma-separated frontend origins ----
# e.g. https://your-frontend.azurestaticapps.net
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
